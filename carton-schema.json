{
  "$schema": "http://json-schema.org/draft-07/schema#",

  "$defs": {
    "profile": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "cxx": { "type": "string" },
        "c": { "type": "string" },
        "ar": { "type": "string" },
        "modules": { "type": "string" },
        "debug": { "type": "boolean" },
        "lto": { "type": "boolean" },
        "opt-level": { "type": "integer" },
        "sanitize": { "type": "array", "items": { "type": "string" } },
        "flags": { "type": "array", "items": { "type": "string" } },
        "link-flags": { "type": "array", "items": { "type": "string" } }
      }
    },

    "package": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "version": { "type": "string", "pattern": "^\\d+\\.\\d+(\\.\\d+)?$" },
        "edition": {
          "type": "integer",
          "enum": [11, 14, 17, 20, 23, 26],
          "default": 17
        },
        "authors": { "type": "array", "items": { "type": "string" } },
        "description": { "type": "string" },
        "license": { "type": "string" },
        "license-file": { "type": "string" },
        "readme": { "type": "string" },
        "repository": { "type": "string" },
        "homepage": { "type": "string" },
        "documentation": { "type": "string" },
        "keywords": { "type": "array", "items": { "type": "string" } }
      }
    },

    "sourceSpec": {
      "type": "object",
      "properties": {
        "subdir": { "type": "string" },
        "src": { "type": "array", "items": { "type": "string" } },
        "inc": { "type": "array", "items": { "type": "string" } },
        "lib": { "type": "array", "items": { "type": "string" } },
        "mod": { "type": "array", "items": { "type": "string" } },
        "flags": { "type": "array", "items": { "type": "string" } },
        "link-flags": { "type": "array", "items": { "type": "string" } },
        "pre": { "type": "string" }
      }
    },

    "sourceSpecWithExtra": {
      "type": "object",
      "properties": {
        "version": { "type": "string", "pattern": "^\\d+\\.\\d+(\\.\\d+)?$" },
        "path": { "type": "string" },
        "url": { "type": "string" },
        "git": { "type": "string" },
        "tag": { "type": "string" },
        "branch": { "type": "string" },
        "commit": { "type": "string" },
        "subdir": { "type": "string" },
        "src": { "type": "array", "items": { "type": "string" } },
        "inc": { "type": "array", "items": { "type": "string" } },
        "lib": { "type": "array", "items": { "type": "string" } },
        "mod": { "type": "array", "items": { "type": "string" } },
        "flags": { "type": "array", "items": { "type": "string" } },
        "link-flags": { "type": "array", "items": { "type": "string" } },
        "pre": { "type": "string" },
        "features": { "type": "array", "items": { "type": "string" } },
        "optional": { "type": "boolean", "default": false },
        "default-features": { "type": "boolean", "default": true }
      },
      "anyOf": [
        { "oneOf": [
        {
          "required": ["version"],
          "not": {
            "anyOf": [
              { "required": ["path"] },
              { "required": ["url"] },
              { "required": ["git"] },
              { "required": ["tag"] },
              { "required": ["branch"] },
              { "required": ["src"] },
              { "required": ["inc"] },
              { "required": ["lib"] },
              { "required": ["mod"]  },
              { "required": ["flags"] },
              { "required": ["link-flags"] },
              { "required": ["pre"] }
            ]
          }
        },
        {
          "required": ["path"],
          "not": {
            "anyOf": [
              { "required": ["version"] },
              { "required": ["url"] },
              { "required": ["git"] },
              { "required": ["tag"] },
              { "required": ["branch"] },
              { "required": ["commit"] }
            ]
          }
        },
        {
          "required": ["url"],
          "not": {
            "anyOf": [
              { "required": ["version"] },
              { "required": ["path"] },
              { "required": ["git"] },
              { "required": ["tag"] },
              { "required": ["branch"] },
              { "required": ["commit"] }
            ]
          }
        },
        {
          "required": ["git"],
          "not": {
            "anyOf": [
              { "required": ["version"] },
              { "required": ["path"] },
              { "required": ["url"] }
            ]
          },
          "oneOf": [
            { "required": ["tag"], "not": { "required": ["branch", "commit"] } },
            { "required": ["branch"], "not": { "required": ["tag", "commit"] } },
            { "required": ["commit"], "not": { "required": ["tag", "branch"] } }
          ]
        }
        ] },
        { "required": ["src"] },
        { "required": ["inc"] },
        { "required": ["lib"] },
        { "required": ["mod"]  },
        { "required": ["flags"] },
        { "required": ["link-flags"] }
      ]
    },

    "dependency": {
      "oneOf": [
        { "type": "string", "pattern": "^\\d+\\.\\d+(\\.\\d+)?$" },
        { "$ref": "#/$defs/sourceSpecWithExtra" }
      ]
    }
  },

  "type": "object",
  "properties": {
    "profile": {
      "type": "object",
      "properties": {
        "dev": { "$ref": "#/$defs/profile" },
        "release": { "$ref": "#/$defs/profile" }
      }
    },

    "package": { "$ref": "#/$defs/package" },

    "lib": { "$ref": "#/$defs/sourceSpec" },

    "dependencies": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/dependency" }
    },

    "features": {
      "type": "object",
      "additionalProperties": { "type": "array", "items": { "type": "string" } }
    }
  }
}
