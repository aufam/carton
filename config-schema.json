{
  "$schema": "http://json-schema.org/draft-07/schema#",

  "$defs": {
    "profile": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "cxx": { "type": "string" },
        "c": { "type": "string" },
        "ar": { "type": "string" },
        "modules": { "type": "string" },
        "debug": { "type": "boolean" },
        "lto": { "type": "boolean" },
        "opt-level": { "type": "integer" },
        "sanitize": { "type": "array", "items": { "type": "string" } },
        "flags": { "type": "array", "items": { "type": "string" } },
        "link-flags": { "type": "array", "items": { "type": "string" } }
      }
    }
  },

  "type": "object",
  "properties": {
    "profile": {
      "type": "object",
      "properties": {
        "dev": { "$ref": "#/$defs/profile" },
        "release": { "$ref": "#/$defs/profile" }
      }
    }
  }
}
